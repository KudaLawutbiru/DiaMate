function generateMemberId(email) {
  let h = 0;
  for (let i = 0; i < email.length; i++) {
    h = ((h << 5) - h) + email.charCodeAt(i);
    h |= 0;
  }
  const num = Math.abs(h).toString().slice(0, 6).padStart(6, '0');
  return 'DM-' + num.slice(0, 3) + '-' + num.slice(3, 6);
}


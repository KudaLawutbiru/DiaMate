  { q: "Jika lupa minum obat, sebaiknya…",
    opsi: ["Minum 2x dosis", "Berhenti minum obat", "Konsultasi ke tenaga kesehatan", "Diamkan saja"], benar: 2 },
  { q: "Tanda bahaya yang perlu segera ke faskes adalah…",
    opsi: ["Luka kaki tidak sembuh", "Gula darah stabil", "Berat badan ideal", "Tidak ada keluhan"], benar: 0 }
];

function buildQuiz() {
  const formKuis = document.getElementById('formKuis');
  if (!formKuis) return;
  if (formKuis.querySelector('.quiz-q')) return;
  formKuis.innerHTML = '';
  soal.forEach((s, i) => {
    const div = document.createElement('div');
    div.className = 'quiz-q';
    let html = `<p>${i + 1}. ${s.q}</p>`;
    s.opsi.forEach((o, j) => {
      html += `<label id="q${i}-o${j}"><input type="radio" name="q${i}" value="${j}"> <span>${o}</span></label>`;
    });
    div.innerHTML = html;
    formKuis.appendChild(div);
    div.querySelectorAll('input').forEach(inp => {
      inp.addEventListener('change', () => {
        s.opsi.forEach((_, j) => {
          const el = document.getElementById(`q${i}-o${j}`);
          if (el) el.classList.remove('correct','wrong');
        });
        playTone('click');
      });
    });
  });
}

function periksaKuis() {
  let skor = 0;
  let unanswered = 0;
  soal.forEach((s, i) => {
    const pilihan = document.querySelector(`input[name="q${i}"]:checked`);
    s.opsi.forEach((_, j) => {
      const el = document.getElementById(`q${i}-o${j}`);
      if (el) el.classList.remove('correct','wrong');
    });
    const benarEl = document.getElementById(`q${i}-o${s.benar}`);
    if (benarEl) benarEl.classList.add('correct');
    if (pilihan) {
      if (parseInt(pilihan.value) === s.benar) skor++;
      else {
        const wrongEl = document.getElementById(`q${i}-o${pilihan.value}`);
        if (wrongEl) wrongEl.classList.add('wrong');
      }
    } else {
      unanswered++;
    }
  });

  const hasil = document.getElementById('hasil');
  if (!hasil) return;
  const nilai = Math.round((skor / soal.length) * 100);
  const pesan = nilai >= 80 ? "Pemahaman Anda sangat baik." :
                nilai >= 60 ? "Bagus. Pelajari kembali materi untuk hasil lebih baik." :
                              "Ayo baca materi lagi, Anda pasti bisa.";
  const warning = unanswered > 0 ? `<br><span style="color: var(--pink-dark); font-size:.85rem;">Ada ${unanswered} soal belum dijawab.</span>` : '';
  hasil.innerHTML = `Skor Anda: <b>${skor}/${soal.length}</b> (Nilai: ${nilai})${warning}<br><span style="color: var(--ink-soft); font-weight:400;">${pesan}</span>`;
  hasil.classList.remove('show');
  void hasil.offsetWidth;
  hasil.classList.add('show');
  playTone(skor === soal.length ? 'success' : 'click');
  showToast(skor === soal.length ? 'Sempurna, nilai 100 ✦' : `Skor: ${skor}/${soal.length}`);
  setTimeout(() => { hasil.scrollIntoView({ behavior:'smooth', block:'center' }); }, 150);
}

function resetKuis() {
  document.querySelectorAll('#formKuis input[type="radio"]').forEach(i => i.checked = false);
  document.querySelectorAll('#formKuis .correct, #formKuis .wrong').forEach(el => {
    el.classList.remove('correct','wrong');
  });
  const hasil = document.getElementById('hasil');
  if (hasil) {
    hasil.classList.remove('show');
    hasil.innerHTML = '';
  }
  playTone('click');
  showToast('Kuis direset');
}


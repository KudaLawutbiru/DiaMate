  }
  .status-box .dots span:nth-child(2) { animation-delay:.2s; }
  .status-box .dots span:nth-child(3) { animation-delay:.4s; }

  table {
    width:100%; border-collapse:separate; border-spacing:0;
    margin-top:10px; font-size:.9rem;
    border-radius:14px; overflow:hidden;
    box-shadow: 0 4px 16px rgba(30,58,138,.07);

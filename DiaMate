  th, td { padding:12px 16px; text-align:left; }
  th {
    background: linear-gradient(135deg, var(--purple-dark), var(--purple));
    color:#fff; font-weight:400; font-size:.82rem; letter-spacing:1.5px;
    font-family: var(--font-brand);
    text-transform: uppercase;
  }
  td {
    background: rgba(239,246,255,.5);
    border-bottom:1px solid rgba(30,64,175,.1);
    color: var(--ink-soft); font-weight: 500;
  }
  tr { transition: background .3s ease; }
  tr:hover td { background: rgba(30,64,175,.08); }
  tr:last-child td { border-bottom:none; }

  .alert {
    padding:16px 20px; border-radius:14px; margin:12px 0;
    font-size:.92rem;
    transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .4s ease;
    position: relative;
    border-left: 5px solid transparent;
    font-weight: 500;
  }
  .alert:hover {
    transform: translateX(8px) rotate(-.5deg);
    box-shadow: 0 8px 24px rgba(30,58,138,.13);
  }
  .alert-label {
    display: block; font-size: .92rem; font-weight: 700;
    letter-spacing: 1.2px; text-transform: uppercase;
    margin-bottom: 5px; opacity: .9; font-style: italic;
  }
  .alert-info {

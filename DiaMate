function glucoseCategory(v) {
  if (v < 70) return { cls: 'badge-low', label: 'Rendah' };
  if (v < 100) return { cls: 'badge-normal', label: 'Normal' };
  if (v < 126) return { cls: 'badge-high', label: 'Pra-DM' };
  if (v < 200) return { cls: 'badge-high', label: 'Tinggi' };
  return { cls: 'badge-vhigh', label: 'Sangat Tinggi' };
}

function initGlucoseForm() {
  const d = document.getElementById('glucDate');
  if (d && !d.value) d.value = formatDateKey(new Date());
  const t = document.getElementById('glucTime');
  if (t && !t.value) {
    const now = new Date();
    t.value = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
  }
}

function addGlucoseEntry() {
  const dateVal = document.getElementById('glucDate').value;
  const timeVal = document.getElementById('glucTime').value;
  const valRaw = document.getElementById('glucVal').value;
  const noteVal = document.getElementById('glucNote').value.trim();

  if (!dateVal) { playTone('error'); showToast('Tanggal belum diisi'); return; }
  const val = parseFloat(valRaw);
  if (isNaN(val) || val < 20 || val > 600) {
    playTone('error'); showToast('Kadar gula darah tidak valid (20–600 mg/dL)'); return;
  }

  const data = getGlucoseData();
  data.push({
    id: Date.now() + Math.random().toString(36).slice(2, 7),
    date: dateVal, time: timeVal || '--:--',
    value: val, note: noteVal, ts: Date.now()
  });
  data.sort((a, b) => (b.date + b.time).localeCompare(a.date + a.time));
  saveGlucoseData(data);

  document.getElementById('glucVal').value = '';
  document.getElementById('glucNote').value = '';
  playTone('success');
  showToast('Catatan gula darah tersimpan ✦');
  renderGlucose();
}

function deleteGlucoseEntry(id) {
  const data = getGlucoseData().filter(x => x.id !== id);
  saveGlucoseData(data);
  playTone('click');
  showToast('Catatan dihapus');
  renderGlucose();
}

function clearGlucoseEntries() {
  if (!confirm('Hapus semua catatan gula darah Anda?')) return;
  saveGlucoseData([]);
  playTone('click');
  showToast('Semua catatan dihapus');
  renderGlucose();
}

function renderGlucose() {
  const list = document.getElementById('glucoseList');
  const statsEl = document.getElementById('glucoseStats');
  if (!list || !statsEl) return;

  const data = getGlucoseData();

  if (!data.length) {
    statsEl.innerHTML = '';
    list.innerHTML = '<div class="empty-state">Belum ada catatan gula darah. Mulai catat hari ini ✦</div>';
    return;
  }

  const values = data.map(x => x.value);
  const avg = Math.round(values.reduce((a,b) => a+b, 0) / values.length);
  const min = Math.min(...values);
  const max = Math.max(...values);
  statsEl.innerHTML = `
    <div class="stat-card">
      <div class="stat-label">Rata-rata</div>
      <div class="stat-value">${avg}</div>
      <div class="stat-unit">mg/dL</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Terendah</div>
      <div class="stat-value">${min}</div>
      <div class="stat-unit">mg/dL</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Tertinggi</div>
      <div class="stat-value">${max}</div>
      <div class="stat-unit">mg/dL</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Catatan</div>
      <div class="stat-value">${data.length}</div>
      <div class="stat-unit">entri</div>
    </div>
  `;

  const shown = data.slice(0, 30);
  list.innerHTML = shown.map(x => {
    const cat = glucoseCategory(x.value);
    const d = parseLocalDate(x.date);
    const tanggal = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
    return `
      <div class="entry-item">
        <div class="entry-value">${x.value}</div>
        <div class="entry-main">
          <div class="entry-title">
            <span class="entry-badge ${cat.cls}">${cat.label}</span>
          </div>
          <div class="entry-meta">${tanggal} · ${x.time}${x.note ? ' · ' + escapeHtml(x.note) : ''}</div>
        </div>
        <button class="delete-btn" onclick="deleteGlucoseEntry('${x.id}')" title="Hapus">×</button>
      </div>
    `;
  }).join('');
}


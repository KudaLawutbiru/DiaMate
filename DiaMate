<script>
/* =========================================================
   GLOBAL STATE
   ========================================================= */
let audioCtx = null;
let soundEnabled = true;
let music = null;
let globalSynth = null;
let musicBusy = false;
let toastTimer = null;
let scrollTimer = null;

let currentUser = null;
let lastPersen = 0;

let currentCalDate = new Date();
let selectedDate = new Date();

let resetState = { email: null, code: null, expiresAt: 0 };

const STORAGE_USERS = 'diamate_users';
const STORAGE_SESSION = 'diamate_session';
const STORAGE_RESET = 'diamate_reset_tokens';
const RESET_EXPIRY_MS = 5 * 60 * 1000;
const BAR_DURATION = 20.5;

/* =========================================================
   AUDIO ENGINE
   ========================================================= */
function ensureCtx() {
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    catch { soundEnabled = false; }
  }
  if (audioCtx && audioCtx.state === 'suspended') {
    try { audioCtx.resume(); } catch (e) {}
  }
  return audioCtx;
}

/* Unlock AudioContext pada gesture pertama user (Safari/mobile friendly) */
function unlockAudioOnce() {
  ensureCtx();
  document.removeEventListener('pointerdown', unlockAudioOnce);
  document.removeEventListener('keydown', unlockAudioOnce);
  document.removeEventListener('touchstart', unlockAudioOnce);
}
document.addEventListener('pointerdown', unlockAudioOnce, { passive: true });
document.addEventListener('keydown', unlockAudioOnce);
document.addEventListener('touchstart', unlockAudioOnce, { passive: true });

function playTone(type) {
  if (!soundEnabled) return;
  const ctx = ensureCtx();
  if (!ctx) return;
  const now = ctx.currentTime;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.connect(gain);
  gain.connect(ctx.destination);

  const soft = (f1, f2, vol, dur) => {
    osc.type = 'sine';
    osc.frequency.setValueAtTime(f1, now);
    osc.frequency.exponentialRampToValueAtTime(f2, now + dur * 0.7);
    gain.gain.setValueAtTime(vol, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);
    osc.start(now); osc.stop(now + dur + 0.02);
  };

  if (type === 'click')      soft(520, 420, 0.06, 0.14);
  else if (type === 'hover') soft(900, 900, 0.012, 0.06);
  else if (type === 'toggle') soft(880, 1046, 0.05, 0.14);
  else if (type === 'transition') soft(330, 620, 0.045, 0.32);
  else if (type === 'error') soft(280, 160, 0.07, 0.28);
  else if (type === 'success') {
    [523.25, 659.25, 783.99].forEach((f, i) => {
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type = 'sine'; o.frequency.value = f;
      g.gain.setValueAtTime(0, now + i * 0.09);
      g.gain.linearRampToValueAtTime(0.07, now + i * 0.09 + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.09 + 0.5);
      o.connect(g); g.connect(ctx.destination);
      o.start(now + i * 0.09); o.stop(now + i * 0.09 + 0.55);
    });
  }
}

/* =========================================================
   PIANO SYNTH
   ========================================================= */
class PianoSynth {
  constructor(ctx) {
    this.ctx = ctx;
    this.master = ctx.createGain();
    this.master.gain.value = 0.22;
    this.dry = ctx.createGain();
    this.dry.gain.value = 0.75;
    this.master.connect(this.dry);
    this.dry.connect(ctx.destination);
    this.reverb = this._createReverb(5.0, 2.6);
    this.reverbGain = ctx.createGain();
    this.reverbGain.gain.value = 0.55;
    this.master.connect(this.reverb);
    this.reverb.connect(this.reverbGain);
    this.reverbGain.connect(ctx.destination);
    this.activeOscillators = new Set();
    this.generation = 0;
  }
  _createReverb(seconds, decay) {
    const rate = this.ctx.sampleRate;
    const length = Math.floor(rate * seconds);
    const impulse = this.ctx.createBuffer(2, length, rate);
    for (let ch = 0; ch < 2; ch++) {
      const data = impulse.getChannelData(ch);
      for (let i = 0; i < length; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, decay);
      }
    }
    const conv = this.ctx.createConvolver();
    conv.buffer = impulse;
    return conv;
  }
  playNote(freq, when, duration, velocity) {
    const ctx = this.ctx;
    const t = when ?? ctx.currentTime;
    const vel = (velocity ?? 1) * 0.17;
    const noteGain = ctx.createGain();
    noteGain.connect(this.master);
    noteGain.gain.setValueAtTime(0, t);
    noteGain.gain.linearRampToValueAtTime(vel, t + 0.014);
    noteGain.gain.exponentialRampToValueAtTime(vel * 0.6, t + 0.22);
    noteGain.gain.exponentialRampToValueAtTime(vel * 0.2, t + 1.2);
    noteGain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
    const harmonics = [
      { mult: 1,    gain: 1.00, type: 'sine' },
      { mult: 2,    gain: 0.38, type: 'sine' },
      { mult: 3,    gain: 0.15, type: 'sine' },
      { mult: 4,    gain: 0.08, type: 'triangle' },
      { mult: 5.4,  gain: 0.045, type: 'sine' },
      { mult: 7.2,  gain: 0.02, type: 'sine' }
    ];
    harmonics.forEach(h => {
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = h.type;
      osc.frequency.value = freq * h.mult;
      osc.detune.value = (Math.random() - 0.5) * 4;
      g.gain.value = h.gain;
      osc.connect(g);
      g.connect(noteGain);
      this.activeOscillators.add(osc);
      osc.onended = () => this.activeOscillators.delete(osc);
      osc.start(t);
      osc.stop(t + duration + 0.3);
    });
  }
  stopAll() {
    const now = this.ctx.currentTime;
    this.activeOscillators.forEach(osc => {
      try { osc.stop(now + 0.02); } catch (e) {}
    });
    this.activeOscillators.clear();
  }
  fadeOut(duration) {
    const now = this.ctx.currentTime;
    const g = this.master.gain;
    try {
      g.cancelScheduledValues(now);
      g.setValueAtTime(g.value, now);
      g.linearRampToValueAtTime(0.0001, now + duration);
    } catch (e) {}
  }
  resetGain() {
    const now = this.ctx.currentTime;
    try {
      this.master.gain.cancelScheduledValues(now);
      this.master.gain.setValueAtTime(0.22, now);
    } catch (e) {}
  }
}

const P = {
  A2: 110.00, C3: 130.81, D3: 146.83, E3: 164.81, F3: 174.61, G3: 196.00, A3: 220.00, B3: 246.94,
  C4: 261.63, D4: 293.66, E4: 329.63, F4: 349.23, G4: 392.00, A4: 440.00, B4: 493.88,
  C5: 523.25, D5: 587.33, E5: 659.25, F5: 698.46, G5: 783.99, A5: 880.00
};

const PROGRESSION = [
  { bass: P.F3, arp: [P.C4, P.F4, P.A4, P.C5, P.E5, P.C5, P.A4], color: P.E5, mel: [P.A4, P.C5, P.F5, P.E5] },
  { bass: P.G3, arp: [P.B3, P.D4, P.G4, P.B4, P.D5, P.B4, P.G4], color: P.F5, mel: [P.D5, P.B4, P.G4, P.D5] },
  { bass: P.E3, arp: [P.B3, P.E4, P.G4, P.B4, P.D5, P.B4, P.G4], color: P.D5, mel: [P.E5, P.B4, P.G4, P.E5] },
  { bass: P.A2, arp: [P.C4, P.E4, P.A4, P.C5, P.E5, P.C5, P.A4], color: P.G5, mel: [P.C5, P.E5, P.A5, P.E5] },
  { bass: P.D3, arp: [P.A3, P.D4, P.F4, P.A4, P.C5, P.A4, P.F4], color: P.E5, mel: [P.D5, P.F5, P.A4, P.C5] },
  { bass: P.G3, arp: [P.B3, P.D4, P.G4, P.B4, P.D5, P.B4, P.G4], color: P.F5, mel: [P.B4, P.D5, P.G5, P.F5] },
  { bass: P.C3, arp: [P.G3, P.C4, P.E4, P.G4, P.B4, P.G4, P.E4], color: P.B4, mel: [P.E5, P.G5, P.C5, P.B4] },
  { bass: P.A2, arp: [P.C4, P.E4, P.A4, P.C5, P.E5, P.C5, P.A4], color: P.E5, mel: [P.C5, P.A4, P.E5, P.C5] },
  { bass: P.F3, arp: [P.A3, P.C4, P.F4, P.A4, P.C5, P.A4, P.F4], color: P.G4, mel: [P.F4, P.A4, P.C5, P.A4] },
  { bass: P.E3, arp: [P.G3, P.B3, P.E4, P.G4, P.B4, P.G4, P.E4], color: P.F4, mel: [P.E5, P.G4, P.B4, P.E5] },
  { bass: P.D3, arp: [P.F3, P.A3, P.D4, P.F4, P.A4, P.F4, P.D4], color: P.E4, mel: [P.D5, P.F4, P.A4, P.D5] },
  { bass: P.C3, arp: [P.E3, P.G3, P.C4, P.E4, P.G4, P.E4, P.C4], color: P.D4, mel: [P.C5, P.E4, P.G4, P.C5] },
  { bass: P.F3, arp: [P.C4, P.F4, P.A4, P.C5, P.E5, P.C5, P.A4], color: P.E5, mel: [P.A4, P.C5, P.E5, P.F5] },
  { bass: P.G3, arp: [P.B3, P.D4, P.G4, P.B4, P.D5, P.B4, P.G4], color: P.D5, mel: [P.B4, P.D5, P.G5, P.B4] },
  { bass: P.C3, arp: [P.G3, P.C4, P.E4, P.G4, P.C5, P.G4, P.E4], color: P.B4, mel: [P.E5, P.G5, P.C5, P.G5] },
  { bass: P.G3, arp: [P.B3, P.D4, P.G4, P.B4, P.D5, P.B4, P.G4], color: P.F5, mel: [P.D5, P.B4, P.G4, P.D5] }
];

/* =========================================================
   PIANO PLAYER — absolute-time scheduling
   ========================================================= */
class PianoPlayer {
  constructor(synth) {
    this.synth = synth;
    this.ctx = synth.ctx;
    this.playing = false;
    this.idx = 0;
    this.timer = null;
    this.generation = 0;
    this.originTime = 0;
  }
  start() {
    if (this.playing) return;
    this.playing = true;
    this.generation++;
    this.idx = 0;
    this.originTime = this.ctx.currentTime + 0.2;
    this._tick();
  }
  _tick() {
    if (!this.playing) return;
    const myGen = this.generation;
    const now = this.ctx.currentTime;
    while (this.originTime + this.idx * BAR_DURATION < now + 1.5) {
      const barStart = this.originTime + this.idx * BAR_DURATION;
      const chord = PROGRESSION[this.idx % PROGRESSION.length];
      this._scheduleChord(chord, barStart);
      this.idx++;
    }
    clearTimeout(this.timer);
    this.timer = setTimeout(() => {
      if (this.generation !== myGen || !this.playing) return;
      this._tick();
    }, 800);
  }
  _scheduleChord(chord, now) {
    const bar = BAR_DURATION;
    this.synth.playNote(chord.bass, now, 18, 0.82);
    this.synth.playNote(chord.bass * 2, now + 0.04, 15, 0.28);

    const spacing = (bar - 4) / (chord.arp.length + 1.5);
    chord.arp.forEach((freq, i) => {
      const t = now + 0.7 + i * spacing;
      const vel = 0.45 + Math.random() * 0.15;
      this.synth.playNote(freq, t, 5, vel);
    });

    this.synth.playNote(chord.color, now + 6.5, 4.5, 0.36);

    chord.mel.forEach((freq, i) => {
      const t = now + 2 + i * 3.2;
      this.synth.playNote(freq, t, 4, 0.38 + Math.random() * 0.1);
    });

    if (Math.random() < 0.65) {
      const shimmer = chord.arp[Math.floor(Math.random() * chord.arp.length)] * 2;
      this.synth.playNote(shimmer, now + 10 + Math.random() * 6, 4.5, 0.22);
    }
    if (Math.random() < 0.4) {
      const sparkle = chord.mel[Math.floor(Math.random() * chord.mel.length)] * 2;
      this.synth.playNote(sparkle, now + 14 + Math.random() * 4, 4, 0.18);
    }
  }
  stop() {
    this.playing = false;
    this.generation++;
    clearTimeout(this.timer);
    this.timer = null;
  }
}

/* =========================================================
   MUSIC CONTROL
   ========================================================= */
function stopMusic() {
  const btn = document.getElementById('music-toggle');
  if (!music) {
    if (btn) btn.classList.add('paused');
    return;
  }
  music.stop();
  music = null;
  if (globalSynth) {
    globalSynth.fadeOut(0.4);
    setTimeout(() => {
      if (!music && globalSynth) {
        globalSynth.stopAll();
        globalSynth.resetGain();
      }
    }, 500);
  }
  if (btn) btn.classList.add('paused');
}

function toggleMusic() {
  if (musicBusy) return;
  musicBusy = true;
  setTimeout(() => { musicBusy = false; }, 600);

  const btn = document.getElementById('music-toggle');
  const ctx = ensureCtx();
  if (!ctx) { showToast('Audio tidak tersedia di browser ini'); musicBusy = false; return; }

  if (music && music.playing) {
    stopMusic();
    playTone('toggle');
    showToast('Piano dijeda');
  } else {
    if (!globalSynth) globalSynth = new PianoSynth(ctx);
    globalSynth.stopAll();
    globalSynth.resetGain();
    music = new PianoPlayer(globalSynth);
    music.start();
    if (btn) btn.classList.remove('paused');
    playTone('toggle');
    showToast('Piano dinyalakan ✦');
  }
}

/* =========================================================
   STAR SCROLL
   ========================================================= */
const STAR_CHARS = ['✦', '✧', '★', '✩', '✦'];
const STAR_COLORS = ['#1e40af', '#ec4899', '#0ea5e9', '#d4af37', '#7dd3fc'];

let lastScrollY = window.scrollY;
let lastStarTime = 0;

window.addEventListener('scroll', () => {
  const now = Date.now();
  const currentY = window.scrollY;
  const scrollingDown = currentY > lastScrollY;
  const delta = Math.abs(currentY - lastScrollY);

  if (scrollingDown && delta > 6 && now - lastStarTime > 90) {
    lastStarTime = now;
    const count = delta > 40 ? 2 : 1;
    for (let i = 0; i < count; i++) setTimeout(() => spawnStar(), i * 60);
  }
  lastScrollY = currentY;
}, { passive: true });

function spawnStar() {
  const star = document.createElement('div');
  star.className = 'scroll-star';
  star.textContent = STAR_CHARS[Math.floor(Math.random() * STAR_CHARS.length)];
  star.style.left = (Math.random() * 92 + 4) + 'vw';
  star.style.top = (Math.random() * 60 + 30) + 'vh';
  star.style.color = STAR_COLORS[Math.floor(Math.random() * STAR_COLORS.length)];
  star.style.fontSize = (Math.random() * 14 + 10) + 'px';
  star.style.textShadow = `0 0 12px ${star.style.color}`;
  star.style.animationDuration = (Math.random() * 1 + 1.8) + 's';
  document.body.appendChild(star);
  setTimeout(() => star.remove(), 2600);
}

/* =========================================================
   USER & SESSION
   ========================================================= */
function userKey(base) {
  const id = currentUser ? currentUser.email : 'guest';
  return `${base}_${id}`;
}

function hashPass(str) {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = ((h << 5) - h) + str.charCodeAt(i);
    h |= 0;
  }
  return 'h' + Math.abs(h).toString(36);
}

function getUsers() { try { return JSON.parse(localStorage.getItem(STORAGE_USERS) || '[]'); } catch { return []; } }
function saveUsers(u) { localStorage.setItem(STORAGE_USERS, JSON.stringify(u)); }
function getSession() { try { return JSON.parse(localStorage.getItem(STORAGE_SESSION) || 'null'); } catch { return null; } }
function setSession(u) { localStorage.setItem(STORAGE_SESSION, JSON.stringify(u)); }
function clearSession() { localStorage.removeItem(STORAGE_SESSION); }

function showToast(msg, duration = 2400) {
  const toast = document.getElementById('toast');
  if (!toast) return;
  toast.textContent = msg;
  toast.classList.remove('hide', 'show');
  void toast.offsetWidth;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toast.classList.remove('show');
    toast.classList.add('hide');
    setTimeout(() => toast.classList.remove('hide'), 450);
  }, duration);
}

function togglePassword(inputId, btn) {
  const input = document.getElementById(inputId);
  if (!input) return;
  const isVisible = input.type === 'text';
  input.type = isVisible ? 'password' : 'text';
  btn.classList.toggle('active', !isVisible);
  btn.setAttribute('aria-label', isVisible ? 'Lihat kata sandi' : 'Sembunyikan kata sandi');
  playTone('toggle');
  const pos = input.value.length;
  input.focus();
  try { input.setSelectionRange(pos, pos); } catch (e) {}
}

/* ============ CURSOR GLOW ============ */
const glow = document.getElementById('cursor-glow');
let glowX = window.innerWidth/2, glowY = window.innerHeight/2;
let glowTX = glowX, glowTY = glowY;

function updateGlow() {
  glowX += (glowTX - glowX) * 0.14;
  glowY += (glowTY - glowY) * 0.14;
  glow.style.transform = `translate(${glowX}px, ${glowY}px) translate(-50%,-50%)`;
  requestAnimationFrame(updateGlow);
}
window.addEventListener('pointermove', (e) => {
  glowTX = e.clientX; glowTY = e.clientY;
  if (glow.style.opacity !== '1') glow.style.opacity = '1';
}, { passive: true });
document.addEventListener('pointerleave', () => { glow.style.opacity = '0'; });
document.addEventListener('pointerenter', () => { glow.style.opacity = '1'; });
updateGlow();

/* ============ SCROLL REVEAL ============ */
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -50px 0px' });

function initReveals() {
  document.querySelectorAll('.reveal').forEach(el => {
    if (!el.classList.contains('visible')) revealObserver.observe(el);
  });
}
function refreshRevealsInView() {
  const selector = '.page.active .reveal:not(.visible), aside .reveal:not(.visible)';
  document.querySelectorAll(selector).forEach(el => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight - 60 && rect.bottom > 0) {
      setTimeout(() => el.classList.add('visible'), 40);
    }
  });
}

/* ============ SMOOTH SCROLL ============ */
function scrollToTarget(id) {
  const target = document.getElementById(id);
  if (!target) return;
  const page = target.closest('.page');
  const needsPageChange = page && !page.classList.contains('active');

  if (needsPageChange) { showPage(page.id); playTone('transition'); }
  else { playTone('click'); }

  setTimeout(() => {
    const navHeight = document.querySelector('nav.mainnav')?.offsetHeight || 60;
    const y = target.getBoundingClientRect().top + window.pageYOffset - navHeight - 20;
    window.scrollTo({ top: y, behavior: 'smooth' });
    target.classList.add('visible');
    target.classList.remove('highlight');
    void target.offsetWidth;
    target.classList.add('highlight');
    setTimeout(() => target.classList.remove('highlight'), 1800);
    const title = target.querySelector('h3');
    if (title) showToast(title.textContent.slice(0, 40));
  }, needsPageChange ? 500 : 80);
  return false;
}


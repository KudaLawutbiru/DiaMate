  .status-box {
    background: linear-gradient(135deg, var(--purple-dark), var(--purple), var(--cyan));
    background-size: 200% 200%;
    animation: rainbowShift 8s ease infinite;
    color:#fff; border-radius:18px; padding:26px 20px;
    text-align:center;
    box-shadow: 0 12px 34px rgba(30,58,138,.35), inset 0 0 0 2px rgba(255,255,255,.2);
    position:relative; overflow:hidden;
  }
  .status-box::before {
    content:""; position:absolute; top:-50%; left:-50%;
    width:200%; height:200%;
    background: linear-gradient(45deg, transparent 35%, rgba(255,255,255,.3) 50%, transparent 65%);
    animation: spinSlow 14s linear infinite; pointer-events:none;
  }
  .status-box .angka {
    font-size:2.8rem; color:#fff;
    position:relative; z-index:1;
    transition: transform .4s cubic-bezier(.34,1.56,.64,1);
    letter-spacing: 2px;
    text-shadow: 0 4px 12px rgba(0,0,0,.15);
  }
  .status-box .angka.bump { transform: scale(1.18); }
  .status-box small {
    display:block; font-size:.9rem; opacity:.95;

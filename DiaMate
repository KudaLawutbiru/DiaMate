function getGlucoseData() {
  try { return JSON.parse(localStorage.getItem(userKey('diamate_glucose')) || '[]'); } catch { return []; }
}
function saveGlucoseData(d) {
  localStorage.setItem(userKey('diamate_glucose'), JSON.stringify(d));

function isValidEmail(email) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email); }

function doRegister() {
  clearErrors();
  const name = document.getElementById('regName').value.trim();
  const email = document.getElementById('regEmail').value.trim().toLowerCase();
  const pass = document.getElementById('regPass').value;
  const pass2 = document.getElementById('regPass2').value;
  let valid = true;

  if (name.length < 3) { setError('regName', 'errRegName', true); valid = false; }
  if (!isValidEmail(email)) { setError('regEmail', 'errRegEmail', true); valid = false; }
  if (pass.length < 6) { setError('regPass', 'errRegPass', true); valid = false; }
  if (pass !== pass2) { setError('regPass2', 'errRegPass2', true); valid = false; }

  if (!valid) { playTone('error'); showToast('Periksa kembali form Anda'); return; }

  const users = getUsers();
  if (users.some(u => u.email === email)) {
    setError('regEmail', 'errRegEmail', true, 'Email sudah terdaftar');
    playTone('error');
    showToast('Email sudah terdaftar');
    return;
  }

  const newUser = { name, email, pass: hashPass(pass), tanggal: new Date().toISOString() };
  users.push(newUser);
  saveUsers(users);
  playTone('success');
  showToast('Akun berhasil dibuat ✦');
  document.getElementById('formRegister').reset();
  setTimeout(() => { setSession(newUser); enterApp(newUser); }, 600);
}

function doLogin() {
  clearErrors();
  const email = document.getElementById('loginEmail').value.trim().toLowerCase();
  const pass = document.getElementById('loginPass').value;

  let valid = true;
  if (!email) { setError('loginEmail', 'errLoginEmail', true); valid = false; }
  if (!pass) { setError('loginPass', 'errLoginPass', true); valid = false; }
  if (!valid) { playTone('error'); return; }

  const users = getUsers();
  const user = users.find(u => u.email === email && u.pass === hashPass(pass));

  if (!user) {
    setError('loginEmail', 'errLoginEmail', true, 'Email atau kata sandi salah');
    playTone('error');
    showToast('Email atau kata sandi salah');
    return;
  }

  playTone('success');
  showToast(`Halo ${user.name}, selamat datang kembali ✦`);
  document.getElementById('formLogin').reset();
  setSession(user);
  setTimeout(() => enterApp(user), 500);
}

function doLogout() {
  playTone('click');
  showToast('Anda telah keluar');
  stopMusic();
  setTimeout(() => {
    clearSession();
    currentUser = null;
    lastPersen = 0;
    currentCalDate = new Date();

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }
  .cal-day {
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; font-weight: 600;
    cursor: pointer;
    background: rgba(255,255,255,.75);
    color: var(--ink);
    border: 1.5px solid transparent;
    transition: all .3s cubic-bezier(.34,1.56,.64,1);
    position: relative; user-select: none;
  }
  .cal-day:hover {
    transform: translateY(-3px) scale(1.06);
    background: #fff;
    border-color: var(--purple-light);
    box-shadow: 0 6px 14px rgba(30,58,138,.15);
    color: var(--purple-dark);
  }
  .cal-day.other-month {
    color: #cbd5e1; background: transparent;
    cursor: default; pointer-events: none; font-weight: 400;
  }
  .cal-day.today {
    border-color: var(--cyan); color: var(--cyan); font-weight: 700;
  }
  .cal-day.today::after {
    content: ""; position: absolute;
    bottom: 5px; left: 50%;
    transform: translateX(-50%);
    width: 4px; height: 4px; border-radius: 50%;
    background: var(--cyan);
  }
  .cal-day.selected {
    background: linear-gradient(135deg, var(--purple-dark), var(--purple));
    color: #fff; border-color: transparent;
    transform: translateY(-2px) scale(1.08);
    animation: softGlow 2.5s ease-in-out infinite;
  }
  .cal-day.selected.today { color: #fff; }
  .cal-day.selected.today::after { background: var(--gold-light); }
  .cal-day.done-part::before {
    content: "";
    position: absolute;
    top: 5px; right: 5px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 8px rgba(236,72,153,.7);
    animation: dotBlink 2s ease-in-out infinite;
  }

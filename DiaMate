  .bubble { position:absolute; border-radius:50%; pointer-events:none; }
  .bubble.b1 { width:200px; height:200px; top:-50px; left:5%;
    background: radial-gradient(circle, rgba(147,197,253,.55), transparent 70%);
    animation: floatSlow 11s ease-in-out infinite; }
  .bubble.b2 { width:150px; height:150px; bottom:20px; right:8%;

function startReminderWatcher() {
  setInterval(() => {
    if (!currentUser) return;
    const now = new Date();
    const nowKey = formatDateKey(now) + 'T' + String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
    const list = getReminders();
    let changed = false;
    list.forEach(x => {
      const key = x.date + 'T' + x.time;
      if (!x.notified && key <= nowKey) {
        x.notified = true;
        changed = true;
        showToast(`⏰ Pengingat: ${x.title}`, 4000);
        playTone('success');
      }
    });
    if (changed) { saveReminders(list); renderReminder(); }
  }, 60000);
}


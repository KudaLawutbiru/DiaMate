    padding:15px 18px; margin-bottom:8px; border-radius:14px;
    background: rgba(255,255,255,.8); font-size:.92rem;
    cursor:pointer; user-select: none;
    transition: all .4s cubic-bezier(.34,1.56,.64,1);
    border: 1.5px solid rgba(30,64,175,.14);
    font-weight: 500;
  }
  .check-item:hover {
    background: rgba(239,246,255,.85);
    transform: translateX(8px) rotate(-.5deg);
    border-color: rgba(30,64,175,.5);
    box-shadow: 0 6px 18px rgba(30,58,138,.1);
  }
  .check-item input {
    width:22px; height:22px; margin-top:1px;

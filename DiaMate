function generateResetCode() {
  return String(Math.floor(100000 + Math.random() * 900000));
}

function handleForgotEmail() {
  const email = document.getElementById('forgotEmail').value.trim().toLowerCase();
  const errEl = document.getElementById('errForgotEmail');
  if (!errEl) return;

  errEl.classList.remove('show');
  errEl.textContent = 'Email tidak ditemukan';

  if (!isValidEmail(email)) {
    errEl.textContent = 'Format email tidak valid';
    errEl.classList.add('show');
    playTone('error');
    return;
  }

  const users = getUsers();
  const user = users.find(u => u.email === email);
  if (!user) {
    errEl.textContent = 'Email tidak terdaftar di DiaMate';
    errEl.classList.add('show');
    playTone('error');
    showToast('Email tidak terdaftar');
    return;
  }

  const code = generateResetCode();
  const expiresAt = Date.now() + RESET_EXPIRY_MS;
  const tokens = getResetTokens();
  tokens[email] = { code, expiresAt, attempts: 0 };
  saveResetTokens(tokens);

  resetState.email = email;
  resetState.code = code;
  resetState.expiresAt = expiresAt;

  document.getElementById('forgotStep1').classList.add('hide');
  document.getElementById('forgotStep2').classList.remove('hide');
  document.getElementById('sentToEmail').textContent = email;
  document.getElementById('mockCode').textContent = code.split('').join(' ');
  document.getElementById('forgotCode').value = '';

  playTone('success');
  showToast('Kode verifikasi terkirim ke email Anda ✦');

  setTimeout(() => { const f = document.getElementById('forgotCode'); if (f) f.focus(); }, 300);
}

function handleForgotCode() {
  const code = document.getElementById('forgotCode').value.trim();
  const errEl = document.getElementById('errForgotCode');
  if (!errEl) return;
  errEl.classList.remove('show');

  if (!resetState.email) {
    errEl.textContent = 'Sesi tidak valid, mulai ulang';
    errEl.classList.add('show');
    playTone('error');
    return;
  }

  const tokens = getResetTokens();
  const token = tokens[resetState.email];

  if (!token) {
    errEl.textContent = 'Kode tidak ditemukan, kirim ulang';
    errEl.classList.add('show');
    playTone('error');
    return;
  }

  if (Date.now() > token.expiresAt) {
    errEl.textContent = 'Kode kedaluwarsa, kirim ulang';
    errEl.classList.add('show');
    playTone('error');
    showToast('Kode sudah kedaluwarsa');
    return;
  }

  if (code !== token.code) {
    token.attempts = (token.attempts || 0) + 1;
    saveResetTokens(tokens);
    errEl.textContent = `Kode salah (${token.attempts}/5 percobaan)`;
    errEl.classList.add('show');
    playTone('error');
    if (token.attempts >= 5) {
      delete tokens[resetState.email];
      saveResetTokens(tokens);
      errEl.textContent = 'Terlalu banyak percobaan. Kirim ulang kode.';
      showToast('Terlalu banyak percobaan');
    }
    return;
  }

  document.getElementById('forgotStep2').classList.add('hide');
  document.getElementById('forgotStep3').classList.remove('hide');
  document.getElementById('resetForEmail').textContent = resetState.email;
  playTone('success');
  showToast('Kode terverifikasi ✦');
  setTimeout(() => { const f = document.getElementById('newPass'); if (f) f.focus(); }, 300);
}

function resendForgotCode() {
  if (!resetState.email) { openForgotModal(); return; }
  const code = generateResetCode();
  const expiresAt = Date.now() + RESET_EXPIRY_MS;
  const tokens = getResetTokens();
  tokens[resetState.email] = { code, expiresAt, attempts: 0 };
  saveResetTokens(tokens);
  resetState.code = code;
  resetState.expiresAt = expiresAt;
  document.getElementById('mockCode').textContent = code.split('').join(' ');
  document.getElementById('forgotCode').value = '';
  const errEl = document.getElementById('errForgotCode');
  if (errEl) errEl.classList.remove('show');
  playTone('success');
  showToast('Kode baru terkirim ✦');
}

function handleNewPassword() {
  const p1 = document.getElementById('newPass').value;
  const p2 = document.getElementById('newPass2').value;
  let valid = true;

  ['errNewPass','errNewPass2'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  });

  if (p1.length < 6) {
    const el = document.getElementById('errNewPass');
    if (el) el.classList.add('show');
    valid = false;
  }
  if (p1 !== p2) {
    const el = document.getElementById('errNewPass2');
    if (el) el.classList.add('show');
    valid = false;
  }
  if (!valid) { playTone('error'); return; }

  const users = getUsers();
  const idx = users.findIndex(u => u.email === resetState.email);
  if (idx === -1) {
    playTone('error'); showToast('Akun tidak ditemukan');
    closeForgotModal();
    return;
  }

  users[idx].pass = hashPass(p1);
  saveUsers(users);

  const tokens = getResetTokens();
  delete tokens[resetState.email];
  saveResetTokens(tokens);

  playTone('success');
  showToast('Kata sandi berhasil diperbarui ✦', 3200);

  const emailForLogin = resetState.email;
  closeForgotModal();

  const loginEmail = document.getElementById('loginEmail');
  if (loginEmail) {
    loginEmail.value = emailForLogin || '';
    setTimeout(() => { const f = document.getElementById('loginPass'); if (f) f.focus(); }, 400);
  }
}

/* =========================================================
   UTIL
   ========================================================= */
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}

/* ============ SCROLL: bubble parallax + refresh reveal ============ */
window.addEventListener('scroll', () => {
  const hero = document.getElementById('hero');
  if (hero && hero.style.display !== 'none') {
    const y = window.scrollY;
    document.querySelectorAll('.bubble').forEach((b, i) => {
      const speed = (i + 1) * 0.12;
      b.style.transform = `translateY(${y * speed}px)`;
    });
  }
  clearTimeout(scrollTimer);
  scrollTimer = setTimeout(refreshRevealsInView, 120);
}, { passive: true });

/* ============ HOVER SOUND ============ */
document.addEventListener('mouseover', (e) => {
  const el = e.target.closest('button, a, .check-item, .quiz-q label, .cal-day');
  if (el && !el.dataset.hovered) {
    el.dataset.hovered = '1';
    if (Math.random() < 0.4) playTone('hover');
    setTimeout(() => delete el.dataset.hovered, 300);
  }
}, { passive: true });
</script>


  document.querySelectorAll('.error-msg').forEach(e => e.classList.remove('show'));
  const defaults = {
    errLoginEmail: 'Email tidak boleh kosong',
    errLoginPass: 'Kata sandi tidak boleh kosong',
    errRegName: 'Nama minimal 3 karakter',
    errRegEmail: 'Format email tidak valid',
    errRegPass: 'Kata sandi minimal 6 karakter',
    errRegPass2: 'Konfirmasi kata sandi tidak cocok'
  };

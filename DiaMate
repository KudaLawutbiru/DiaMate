    background: linear-gradient(90deg, var(--purple-dark), var(--purple), var(--cyan), var(--pink), var(--gold));
    background-size: 300% 100%;
    animation: rainbowShift 4s ease infinite;
    border-radius:12px;
    transition: width .8s cubic-bezier(.22,1,.36,1);
    box-shadow: 0 0 16px rgba(30,64,175,.5);
  }

  .calendar-widget {
    background: linear-gradient(180deg, rgba(239,246,255,.7), rgba(255,255,255,.9));
    border: 1.5px solid rgba(30,64,175,.15);

  .hero .badge::after {
    content:""; position:absolute; inset:0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.45), transparent);
    transform: translateX(-120%) skewX(-20deg);
    animation: shimmerSweep 4.5s ease-in-out infinite;

function renderCalendar() {
  const calGrid = document.getElementById('calGrid');
  const calTitle = document.getElementById('calTitle');
  if (!calGrid || !calTitle) return;

  const y = currentCalDate.getFullYear();
  const m = currentCalDate.getMonth();
  calTitle.textContent = `${BULAN[m]} ${y}`;

  calGrid.innerHTML = '';

  const firstDay = new Date(y, m, 1).getDay();
  const offset = firstDay === 0 ? 6 : firstDay - 1;
  const daysInMonth = new Date(y, m + 1, 0).getDate();
  const daysInPrev = new Date(y, m, 0).getDate();

  const todayKey = formatDateKey(new Date());
  const selectedKey = formatDateKey(selectedDate);
  const data = getChecklistData();
  const notes = getDiaryNotes();
  const totalItems = itemChecklist.length;

  for (let i = offset - 1; i >= 0; i--) {
    const d = document.createElement('div');
    d.className = 'cal-day other-month';
    d.textContent = daysInPrev - i;
    calGrid.appendChild(d);
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const d = document.createElement('div');
    d.className = 'cal-day';
    const key = `${y}-${String(m + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    d.textContent = day;
    d.dataset.date = key;

    if (key === todayKey) d.classList.add('today');
    if (key === selectedKey) d.classList.add('selected');

    const dayData = data[key] || [];
    const checkedCount = dayData.filter(Boolean).length;
    if (checkedCount === totalItems) d.classList.add('done-full');
    else if (checkedCount > 0) d.classList.add('done-part');
    if (notes[key] && notes[key].trim()) d.classList.add('has-note');

    d.addEventListener('click', () => {
      selectedDate = new Date(y, m, day);
      playTone('click');
      renderCalendar();
      loadChecklistForDate();
    });

    calGrid.appendChild(d);
  }

  const totalCells = offset + daysInMonth;
  const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
  for (let i = 1; i <= remaining; i++) {
    const d = document.createElement('div');
    d.className = 'cal-day other-month';
    d.textContent = i;
    calGrid.appendChild(d);
  }
}

function loadChecklistForDate() {
  const key = formatDateKey(selectedDate);
  const data = getChecklistData();
  const dayData = data[key] || [];

  itemChecklist.forEach((_, i) => {
    const cb = document.getElementById('chk' + i);
    if (!cb) return;
    cb.checked = !!dayData[i];
    const label = cb.closest('.check-item');
    if (label) label.classList.toggle('checked', cb.checked);
  });

  const notes = getDiaryNotes();
  const noteEl = document.getElementById('diaryNote');
  if (noteEl) noteEl.value = notes[key] || '';

  updateDateLabel();
  updateProgress();
}

function updateDateLabel() {
  const el = document.getElementById('checklistDateLabel');
  if (!el) return;
  const d = selectedDate;
  el.textContent = `✦ ${HARI[d.getDay()]}, ${d.getDate()} ${BULAN[d.getMonth()]} ${d.getFullYear()}`;
}

function buildChecklistItems() {
  const wadah = document.getElementById('daftarChecklist');
  if (!wadah) return;
  if (document.getElementById('chk0')) return;
  wadah.innerHTML = '';
  itemChecklist.forEach((t, i) => {
    const label = document.createElement('label');
    label.className = 'check-item';
    label.htmlFor = 'chk' + i;
    const cb = document.createElement('input');
    cb.type = 'checkbox'; cb.id = 'chk' + i;
    const span = document.createElement('span');
    span.textContent = t;
    label.appendChild(cb); label.appendChild(span);
    wadah.appendChild(label);

    cb.addEventListener('change', () => {
      cb.style.animation = 'none';
      void cb.offsetWidth;
      cb.style.animation = 'checkPop .4s cubic-bezier(.34,1.56,.64,1)';
      playTone(cb.checked ? 'toggle' : 'click');

      const key = formatDateKey(selectedDate);
      const data = getChecklistData();
      const arr = (data[key] || new Array(itemChecklist.length).fill(false));
      arr[i] = cb.checked;
      data[key] = arr;
      saveChecklistData(data);

      label.classList.toggle('checked', cb.checked);
      renderCalendar();
      updateProgress();
    });
  });
}

function saveDiaryNote() {
  const noteEl = document.getElementById('diaryNote');
  if (!noteEl) return;
  const key = formatDateKey(selectedDate);
  const notes = getDiaryNotes();
  const val = noteEl.value.trim();
  if (val) notes[key] = val;
  else delete notes[key];
  saveDiaryNotes(notes);
  renderCalendar();
  playTone('success');
  showToast(val ? 'Catatan tersimpan ✦' : 'Catatan dihapus');
}

function initCalendar() {
  const prev = document.getElementById('calPrev');
  const next = document.getElementById('calNext');
  if (prev) prev.addEventListener('click', () => {
    currentCalDate = new Date(currentCalDate.getFullYear(), currentCalDate.getMonth() - 1, 1);
    playTone('click');
    renderCalendar();
  });
  if (next) next.addEventListener('click', () => {
    currentCalDate = new Date(currentCalDate.getFullYear(), currentCalDate.getMonth() + 1, 1);
    playTone('click');
    renderCalendar();
  });
  renderCalendar();
  loadChecklistForDate();
}

function animateNumber(el, from, to, duration) {
  if (!el) return;
  const start = performance.now();
  function step(now) {
    const t = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - t, 3);
    el.textContent = Math.round(from + (to - from) * eased) + '%';
    if (t < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function updateProgress() {
  const total = itemChecklist.length;
  let terisi = 0;
  for (let i = 0; i < total; i++) {
    const cb = document.getElementById('chk' + i);
    if (cb && cb.checked) terisi++;
  }
  const persen = Math.round((terisi / total) * 100);
  const progressEl = document.getElementById('progress');
  if (progressEl) {
    progressEl.textContent =
      `Progres tanggal ini: ${terisi}/${total} (${persen}%)` + (persen === 100 ? " — Selesai ✦" : "");
  }
  const fill = document.getElementById('progressFill');
  if (fill) fill.style.width = persen + '%';

  const angkaEl = document.getElementById('angkaProgres');
  if (angkaEl) {
    animateNumber(angkaEl, lastPersen, persen, 500);
    angkaEl.classList.add('bump');
    setTimeout(() => angkaEl.classList.remove('bump'), 400);
  }
  if (persen === 100 && lastPersen !== 100) {
    playTone('success');
    showToast('Checklist tanggal ini selesai. Luar biasa ✦');
  }
  lastPersen = persen;
}


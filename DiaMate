<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DiaMate ✦ Teman Diabetes Anda</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Righteous&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --purple:#1e40af;
    --purple-light:#93c5fd;
    --purple-dark:#1e3a8a;
    --pink:#ec4899;
    --pink-light:#f9a8d4;
    --pink-dark:#be185d;
    --cyan:#0ea5e9;
    --cyan-light:#7dd3fc;
    --lime:#a7f3d0;
    --lime-dark:#059669;
    --amber:#fbbf24;
    --orange:#f59e0b;
    --gold:#d4af37;
    --gold-light:#e5c563;
    --cream:#fafaf7;
    --lavender:#eff6ff;
    --sky:#e0ecff;
    --ink:#0f172a;
    --ink-soft:#475569;
    --ink-dim:#64748b;
    --white:#ffffff;

    --font-heading: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
    --font-brand: 'Righteous', 'Playfair Display', sans-serif;
    --font-body: 'DM Sans', 'Space Grotesk', sans-serif;
    --font-accent: 'Cormorant Garamond', 'Playfair Display', serif;
  }

  * { margin:0; padding:0; box-sizing:border-box; font-family: var(--font-body); }

  h1, h2, h3, h4, h5, h6,
  .hero h2,
  .landing-left h1,
  .card h3,
  .card h4,
  aside .widget h4,
  footer h5,
  .status-box small {
    font-family: var(--font-heading);
    letter-spacing: .3px;
    font-weight: 500;
  }

  .brand h1,
  .logo,
  .auth-tabs button,
  .btn, .btn-auth,
  .cta-btn,
  .jump-btn,
  .hero .badge,
  .landing-left .hero-badge,
  .status-box .angka {
    font-family: var(--font-brand);
    letter-spacing: 1px;
    font-weight: 400;
  }

  .breadcrumb, .alert-label, .input-hint, .error-msg,
  nav.mainnav a, .copyright,
  .cal-title, .checklist-date-label,
  .form-group label {
    font-family: var(--font-accent);
    letter-spacing: .4px;
  }

  html { scroll-behavior: smooth; scroll-padding-top: 100px; }
  body {
    background:
      radial-gradient(circle at 12% 8%, rgba(147,197,253,.42), transparent 48%),
      radial-gradient(circle at 88% 15%, rgba(224,236,255,.65), transparent 55%),
      radial-gradient(circle at 50% 92%, rgba(236,72,153,.12), transparent 60%),
      radial-gradient(circle at 78% 62%, rgba(212,175,55,.08), transparent 55%),
      linear-gradient(180deg, #fbfdff 0%, #f0f6ff 55%, #fdf4f8 100%);
    background-attachment: fixed;
    color:var(--ink); line-height:1.7; font-weight:400;
    overflow-x: hidden; min-height:100vh;
  }

  .scroll-star {
    position: fixed; pointer-events: none; z-index: 9998; font-size: 16px;
    animation: starFall 2.4s cubic-bezier(.22,1,.36,1) forwards;
    will-change: transform, opacity; user-select: none;
  }
  @keyframes starFall {
    0%   { opacity: 0; transform: translateY(0) scale(.4) rotate(0deg); }
    15%  { opacity: 1; transform: translateY(-10px) scale(1.1) rotate(45deg); }
    70%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-110px) scale(.3) rotate(280deg); }
  }

  #cursor-glow {
    position: fixed; top:0; left:0;
    width: 360px; height: 360px; border-radius:50%;
    background: radial-gradient(circle, rgba(30,64,175,.22) 0%, rgba(236,72,153,.12) 40%, transparent 70%);
    transform: translate(-50%,-50%);
    pointer-events: none; z-index: 900;
    opacity: 0; transition: opacity .6s ease;
    mix-blend-mode: multiply;
    will-change: transform;
  }
  @media (hover: none) { #cursor-glow { display: none; } }

  @keyframes fadeInUp { from {opacity:0; transform:translateY(28px);} to {opacity:1; transform:translateY(0);} }
  @keyframes fadeInScale { from {opacity:0; transform:scale(.96); filter:blur(6px);} to {opacity:1; transform:scale(1); filter:blur(0);} }
  @keyframes slideInLeft { from {opacity:0; transform:translateX(-32px);} to {opacity:1; transform:translateX(0);} }
  @keyframes floatSlow {
    0%,100% { transform:translateY(0) translateX(0); }
    33% { transform:translateY(-14px) translateX(10px); }
    66% { transform:translateY(8px) translateX(-8px); }
  }
  @keyframes pulseSoft {
    0%,100% { box-shadow: 0 0 0 0 rgba(30,64,175,.42); }
    50% { box-shadow: 0 0 0 16px rgba(30,64,175,0); }
  }
  @keyframes spinSlow { to { transform: rotate(360deg); } }
  @keyframes ripple {
    0% { transform: translate(-50%,-50%) scale(0); opacity:.55; }
    100% { transform: translate(-50%,-50%) scale(20); opacity:0; }
  }
  @keyframes checkPop {
    0% { transform: scale(.4) rotate(-15deg); opacity:0; }
    60% { transform: scale(1.15) rotate(6deg); }
    100% { transform: scale(1) rotate(0); opacity:1; }
  }
  @keyframes waveMove { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes dotBlink {
    0%,100% { opacity:.3; transform:scale(.8); }
    50% { opacity:1; transform:scale(1.2); }
  }
  @keyframes toastIn { from {opacity:0; transform:translate(-50%,40px);} to {opacity:1; transform:translate(-50%,0);} }
  @keyframes toastOut { from {opacity:1; transform:translate(-50%,0);} to {opacity:0; transform:translate(-50%,40px);} }
  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20%,60% { transform: translateX(-8px); }
    40%,80% { transform: translateX(8px); }
  }
  @keyframes curtainUp {
    0% { transform: translateY(0); opacity: 1; visibility: visible; }
    100% { transform: translateY(-100%); opacity: 0; visibility: hidden; }
  }
  @keyframes targetPulse {
    0% { box-shadow: 0 0 0 0 rgba(30,64,175,.5), 0 8px 28px rgba(30,58,138,.1); }
    40% { box-shadow: 0 0 0 20px rgba(30,64,175,0), 0 22px 50px rgba(236,72,153,.35); }
    100% { box-shadow: 0 0 0 0 rgba(30,64,175,0), 0 8px 28px rgba(30,58,138,.1); }
  }
  @keyframes arrowBounce {
    0%,100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }
  @keyframes rainbowShift {
    0%,100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  @keyframes floatStar {
    0%,100% { transform: translateY(0) rotate(0); opacity:.55; }
    50% { transform: translateY(-20px) rotate(180deg); opacity:1; }
  }
  @keyframes shimmerSweep {
    0% { transform: translateX(-120%) skewX(-20deg); opacity:0; }
    40% { opacity:.7; }
    100% { transform: translateX(220%) skewX(-20deg); opacity:0; }
  }
  @keyframes softGlow {
    0%,100% { box-shadow: 0 8px 22px rgba(30,64,175,.38), 0 0 0 3px rgba(236,72,153,.15); }
    50% { box-shadow: 0 12px 30px rgba(30,64,175,.55), 0 0 0 6px rgba(236,72,153,.25); }
  }
  @keyframes discSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes noteFloat {
    0%,100% { transform: translateY(0) rotate(-8deg); }
    50%     { transform: translateY(-2px) rotate(-5deg); }
  }
  @keyframes slideGlowIn {
    0% { opacity:0; transform: translateY(14px) scale(.92); filter:blur(4px); }
    100% { opacity:1; transform: translateY(0) scale(1); filter:blur(0); }
  }
  @keyframes gentleTilt {
    0%,100% { transform: rotate(-4deg) translateY(0); }
    50% { transform: rotate(-2deg) translateY(-3px); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(45px) scale(.98);
    transition: opacity .9s cubic-bezier(.22,1,.36,1), transform .9s cubic-bezier(.22,1,.36,1);
    will-change: opacity, transform;
  }
  .reveal.visible { opacity: 1; transform: translateY(0) scale(1); }
  .reveal-delay-1 { transition-delay: .08s; }
  .reveal-delay-2 { transition-delay: .16s; }
  .reveal-delay-3 { transition-delay: .24s; }

  #music-toggle {
    position: fixed; bottom: 24px; right: 24px; z-index: 998;
    width: 64px; height: 64px; border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #ffffff 0%, #e8eefc 45%, #cfdcf5 100%);
    border: none; cursor: pointer;
    box-shadow:
      0 10px 30px rgba(30,58,138,.35),
      inset 0 0 0 2px rgba(255,255,255,.85),
      inset 0 -4px 10px rgba(30,64,175,.18);
    display: flex; align-items: center; justify-content: center;
    transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .4s ease;
    color: #fff; padding: 0;
  }
  #music-toggle:hover {
    transform: scale(1.1) translateY(-3px) rotate(4deg);
    box-shadow:
      0 16px 40px rgba(30,64,175,.45),
      inset 0 0 0 2px rgba(255,255,255,.95),
      inset 0 -4px 12px rgba(30,64,175,.22);
  }
  #music-toggle:active { transform: scale(.98); }

  #music-toggle svg.cd-icon {
    width: 52px; height: 52px; display: block;
    animation: discSpin 6s linear infinite;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,.12));
    transition: opacity .4s ease;
  }
  #music-toggle.paused svg.cd-icon {
    animation-play-state: paused;
    opacity: .6;
    filter: grayscale(.55) drop-shadow(0 1px 1px rgba(0,0,0,.12));
  }
  #music-toggle.paused::after {
    content: "";
    position: absolute;
    width: 44px; height: 4px;
    background: #1e40af;
    transform: rotate(-45deg);
    border-radius: 3px;
    box-shadow: 0 0 0 2px rgba(255,255,255,.9), 0 0 8px rgba(30,64,175,.55);
    pointer-events: none;
  }
  #music-toggle:not(.paused) svg.cd-icon .note-group {
    animation: noteFloat 2.2s ease-in-out infinite;
    transform-origin: center;
  }

  #landing {
    position: fixed; inset: 0; z-index: 500;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 16px; overflow-y: auto;
    background:
      radial-gradient(circle at 12% 8%, rgba(147,197,253,.5), transparent 45%),
      radial-gradient(circle at 88% 82%, rgba(224,236,255,.65), transparent 55%),
      radial-gradient(circle at 50% 100%, rgba(236,72,153,.13), transparent 60%),
      linear-gradient(180deg, #fbfdff 0%, #eff5ff 100%);
  }
  #landing.hidden { animation: curtainUp .8s cubic-bezier(.86,0,.07,1) forwards; }

  .landing-wrap {
    width: 100%; max-width: 1080px;
    display: grid; grid-template-columns: 1.1fr 1fr;
    gap: 40px; align-items: center;
  }
  @media (max-width: 860px) {
    .landing-wrap { grid-template-columns: 1fr; gap: 28px; max-width: 460px; }
    .landing-left { text-align: center; }
    .landing-left .hero-badge, .landing-left h1 { margin-left: auto; margin-right: auto; }
  }

  .landing-left { animation: slideInLeft .8s ease both; }
  .landing-left .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, var(--purple-dark), var(--purple));
    color: #fff; padding: 8px 22px; border-radius: 30px;
    font-size: .72rem; letter-spacing: 2.5px;
    text-transform: uppercase;
    box-shadow: 0 8px 24px rgba(30,58,138,.32);
    animation: fadeInUp .8s ease both, pulseSoft 3s ease-in-out infinite;
    margin-bottom: 22px;
    position: relative; overflow: hidden;
  }
  .landing-left .hero-badge::after {
    content:""; position:absolute; inset:0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.5), transparent);
    transform: translateX(-120%) skewX(-20deg);
    animation: shimmerSweep 4s ease-in-out infinite;
  }

  .landing-left h1 {
    font-size: 2.9rem; line-height: 1.15;
    color: var(--ink); margin-bottom: 16px;
    animation: fadeInUp .9s ease .1s both;
    font-family: var(--font-brand);
    letter-spacing: 1px; font-weight: 400;
  }
  .landing-left h1 span {
    font-style: italic;
    font-family: var(--font-heading);
    background: linear-gradient(120deg, var(--purple-dark), var(--cyan), var(--pink), var(--purple-dark));
    background-size: 300% auto;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rainbowShift 6s ease infinite;
    padding: 0 4px;
  }
  .landing-left p {
    font-size: 1.05rem; color: var(--ink-soft); max-width: 500px;
    margin-bottom: 12px; animation: fadeInUp 1s ease .2s both;
    font-weight: 500; line-height: 1.7;
  }
  .landing-left .landing-sub {
    font-size: .96rem; color: var(--ink-dim);
    font-family: var(--font-accent); font-style: italic;
    animation: fadeInUp 1.1s ease .3s both;
    max-width: 460px;
    margin-bottom: 0;
  }

  .auth-card {
    background: rgba(255,255,255,.95);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-radius: 24px; padding: 34px 30px;
    box-shadow: 0 24px 60px rgba(30,58,138,.16), 0 0 0 1.5px rgba(30,64,175,.12);
    position: relative; overflow: hidden;
    animation: fadeInScale .8s ease .2s both;
  }
  .auth-card::before {
    content:""; position:absolute; top:0; left:0; right:0; height:4px;
    background: linear-gradient(90deg, var(--purple-dark), var(--purple), var(--cyan), var(--pink), var(--gold), var(--purple-dark));
    background-size: 300% 100%;
    animation: rainbowShift 5s ease infinite;
  }
  .auth-tabs {
    display: flex; gap: 6px; margin-bottom: 24px;
    background: rgba(239,246,255,.85);
    padding: 5px; border-radius: 30px;
  }
  .auth-tabs button {
    flex: 1; padding: 11px 16px; border: none; cursor: pointer;
    background: transparent; color: var(--ink-soft);
    font-size: .88rem; border-radius: 26px;
    transition: all .35s ease;
  }
  .auth-tabs button.active {
    background: linear-gradient(135deg, var(--purple-dark), var(--purple));
    color: #fff;
    box-shadow: 0 6px 18px rgba(30,58,138,.35);
  }
  .auth-tabs button:not(.active):hover { color: var(--purple-dark); }

  .auth-form { animation: fadeInUp .4s ease both; }
  .auth-form.hide { display: none; }

  .form-group { margin-bottom: 16px; }
  .form-group label {
    display: block; font-size: .96rem; font-weight: 600;
    color: var(--ink); margin-bottom: 6px;
    font-style: italic; letter-spacing: .3px;
  }
  .input-wrap { position: relative; }
  .form-group input, .form-group textarea, .form-group select {
    width: 100%; padding: 13px 16px;
    border: 2px solid rgba(30,64,175,.18);
    border-radius: 12px; font-family: inherit;
    font-size: .92rem; color: var(--ink);
    background: rgba(239,246,255,.55);
    transition: all .3s ease; outline: none;
    font-weight: 500;
    resize: vertical;
  }
  .form-group textarea { min-height: 100px; padding: 12px 14px; }
  .form-group select { cursor: pointer; }
  .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
    border-color: var(--purple);
    box-shadow: 0 0 0 4px rgba(30,64,175,.15);
    background: #fff;
  }
  .form-group input.error {
    border-color: var(--pink-dark); background: #fdf2f8;
    animation: shake .4s ease;
  }
  .form-group input::placeholder, .form-group textarea::placeholder { color: #94a3b8; }
  .form-group input[type="password"] { padding-right: 46px; }

  .toggle-pass {
    position: absolute; right: 8px; top: 50%;
    transform: translateY(-50%);
    width: 36px; height: 36px; border-radius: 10px;
    background: transparent; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: var(--ink-soft); transition: all .3s ease;
  }
  .toggle-pass:hover {
    background: rgba(30,64,175,.15);
    color: var(--purple-dark);
    transform: translateY(-50%) scale(1.1);
  }
  .toggle-pass svg { width: 18px; height: 18px; }
  .toggle-pass .icon-eye-off { display: none; }
  .toggle-pass.active .icon-eye { display: none; }
  .toggle-pass.active .icon-eye-off { display: block; }

  .input-hint { font-size: .84rem; color: var(--ink-dim); margin-top: 5px; opacity:.9; font-style: italic; }
  .error-msg { font-size: .84rem; color: var(--pink-dark); margin-top: 5px; font-weight:600; display:none; font-style: italic; }
  .error-msg.show { display: block; animation: fadeInUp .3s ease; }

  .forgot-link-wrap {
    text-align: right;
    margin: -8px 0 10px;
  }
  .forgot-link-wrap button {
    background: none; border: none; cursor: pointer;
    color: var(--purple-dark);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: .92rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(30,64,175,.4);
    padding: 4px 2px;
    transition: color .3s ease;
  }
  .forgot-link-wrap button:hover { color: var(--pink); text-decoration-color: var(--pink); }

  .btn-auth {
    width: 100%; padding: 14px 24px; border: none; cursor: pointer;
    background: linear-gradient(135deg, var(--purple-dark), var(--purple), var(--cyan));
    background-size: 200% 200%;
    color: #fff; border-radius: 12px;
    font-size: 1rem; letter-spacing: 1.5px;
    box-shadow: 0 10px 26px rgba(30,58,138,.35);
    transition: transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease, background-position .6s ease;
    margin-top: 8px; position: relative; overflow: hidden;
  }
  .btn-auth::after {
    content:""; position:absolute; top:50%; left:50%;
    width:10px; height:10px; border-radius:50%;
    background: rgba(255,255,255,.5);
    transform: translate(-50%,-50%) scale(0); opacity: 0;
    pointer-events:none;
  }
  .btn-auth:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 16px 36px rgba(30,64,175,.45);
    background-position: 100% 50%;
  }
  .btn-auth:active::after { animation: ripple .6s ease-out; }

  .auth-footer { margin-top: 16px; text-align: center; font-size: .9rem; color: var(--ink-soft); }
  .auth-footer button {
    background: none; border: none;
    background: linear-gradient(135deg, var(--purple-dark), var(--pink));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700; cursor: pointer;
    font-size: inherit; padding: 0 4px;
    font-family: var(--font-accent); font-style: italic;
    text-decoration: underline; text-decoration-color: rgba(30,64,175,.4);
    transition: color .3s ease;
  }
  .auth-footer button:hover { text-decoration-color: var(--pink); }

  #app { display: none; opacity: 0; }
  #app.show { display: block; animation: pageFadeIn .8s ease .1s forwards; }
  @keyframes pageFadeIn { to { opacity: 1; } }

  .topbar {
    background: linear-gradient(90deg, #0b1e3f, #1e3a8a, #1e40af, #0b1e3f);
    background-size: 300% 100%;
    animation: rainbowShift 14s ease infinite;
    color: rgba(255,255,255,.95);
    font-size:.78rem; padding:10px 24px;
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px;
    font-weight:500; letter-spacing:.4px;
    border-bottom: 1px solid rgba(255,255,255,.15);
  }
  .topbar > div { display:flex; flex-wrap:wrap; align-items:center; }
  .topbar a {
    color: rgba(255,255,255,.9); text-decoration:none; margin-right:16px;
    transition: color .3s ease; position:relative; font-weight: 500;
  }
  .topbar a::after {
    content:""; position:absolute; bottom:-2px; left:0; width:0; height:2px;
    background: var(--gold-light); transition: width .3s ease;
    border-radius: 2px;
  }
  .topbar a:hover { color: var(--gold-light); }
  .topbar a:hover::after { width:100%; }

  .user-area { display: flex; align-items: center; gap: 10px; }
  .user-chip {
    display: flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.15);
    padding: 3px 12px 3px 3px; border-radius: 30px;
    font-size: .78rem;
    border: 1px solid rgba(255,255,255,.28);
    font-weight: 600;
  }
  .user-avatar {
    width: 24px; height: 24px; border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--cyan));
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: .72rem; text-transform: uppercase;
    font-family: var(--font-brand);
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }
  .logout-btn {
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.4);
    color: #fff; padding: 4px 14px; border-radius: 20px;
    cursor: pointer; font-size: .74rem;
    font-weight: 600; transition: all .3s ease;
    font-family: var(--font-body); letter-spacing: .5px;
  }
  .logout-btn:hover {
    background: #fff;
    color: var(--purple-dark);
    border-color: #fff;
    transform: translateY(-1px) scale(1.05);
  }

  header.site-header {
    background: rgba(255,255,255,.93);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    padding:16px 24px; display:flex; align-items:center; gap:16px;
    box-shadow: 0 6px 24px rgba(30,58,138,.07); position: relative;
  }
  header.site-header::after {
    content:""; position:absolute; bottom:0; left:0; right:0; height:3px;
    background: linear-gradient(90deg, var(--purple-dark), var(--purple), var(--cyan), var(--pink), var(--gold), var(--purple-dark));
    background-size: 300% 100%;
    animation: rainbowShift 6s ease infinite;
  }
  .logo {
    width:56px; height:56px; border-radius:16px;
